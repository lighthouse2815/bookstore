# Bookstore Desktop reads these values automatically at startup.
# The API URL must be the backend root; a trailing /api is normalized automatically.
BOOKSTORE_API_BASE_URL=http://localhost:8080
GOOGLE_CLIENT_ID=

# Optional local-only login autofill. Keep these blank outside development.
BOOKSTORE_ENVIRONMENT=
BOOKSTORE_DEV_USERNAME=
BOOKSTORE_DEV_PASSWORD=
