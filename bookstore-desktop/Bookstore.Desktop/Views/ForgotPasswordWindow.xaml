<Window x:Class="Bookstore.Desktop.Views.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bookstore POS"
        Width="860"
        Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBoxForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorderBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBoxForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorderBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.46" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Margin="24"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrushLight}"
            BorderThickness="1"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect Color="#B7C4D6"
                              BlurRadius="24"
                              ShadowDepth="8"
                              Opacity="0.24" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="286" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource AccentSoftBrush}"
                    BorderBrush="{DynamicResource BorderBrushLight}"
                    BorderThickness="0,0,1,0"
                    CornerRadius="18,0,0,18">
                <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Image Source="/Bookstore.Desktop;component/Assets/logo-bookstore.png"
                               Width="72"
                               Height="72"
                               HorizontalAlignment="Left"
                               Stretch="Uniform" />
                        <TextBlock Text="Bookstore POS"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,18,0,6" />
                        <TextBlock Text="Khôi phục tài khoản nhân viên"
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                Margin="0,20">
                        <TextBlock Text="1. Gửi mã OTP"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,14" />
                        <TextBlock Text="2. Xác thực OTP"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,14" />
                        <TextBlock Text="3. Tạo mật khẩu mới"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                    </StackPanel>

                    <Border Grid.Row="2"
                            Padding="14"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrushLight}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <TextBlock Text="Dùng email gắn với tài khoản ADMIN hoặc STAFF."
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1"
                  Margin="46,40,46,36">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,28">
                    <TextBlock Text="Quên mật khẩu"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="Nhập email, xác thực OTP rồi đặt lại mật khẩu."
                               TextWrapping="Wrap"
                               FontSize="14"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,8,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Email"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBox x:Name="EmailTextBox"
                                 Height="48"
                                 Margin="0,10,0,14"
                                 Padding="14,0"
                                 VerticalContentAlignment="Center" />

                        <Button x:Name="SendOtpButton"
                                Height="48"
                                Background="{DynamicResource PrimaryBrush}"
                                BorderBrush="{DynamicResource PrimaryBrush}"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Click="SendOtpButton_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE724;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Gửi OTP"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Grid Margin="0,22,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Height="1"
                                    Background="{DynamicResource BorderBrushLight}"
                                    VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="Sau khi nhận OTP"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="14,0" />
                            <Border Grid.Column="2"
                                    Height="1"
                                    Background="{DynamicResource BorderBrushLight}"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel x:Name="OtpPanel"
                                    IsEnabled="False">
                            <TextBlock Text="Mã OTP"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBox x:Name="OtpTextBox"
                                     Height="48"
                                     Margin="0,10,0,14"
                                     Padding="14,0"
                                     VerticalContentAlignment="Center"
                                     MaxLength="6" />

                            <Button x:Name="VerifyOtpButton"
                                    Height="48"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    BorderBrush="{DynamicResource PrimaryBrush}"
                                    Foreground="{DynamicResource AccentSoftTextBrush}"
                                    FontWeight="SemiBold"
                                    Click="VerifyOtpButton_OnClick">
                                <TextBlock Text="Xác thực OTP" />
                            </Button>
                        </StackPanel>

                        <StackPanel x:Name="ResetPanel"
                                    Visibility="Collapsed"
                                    IsEnabled="False"
                                    Margin="0,20,0,0">
                            <TextBlock Text="Mật khẩu mới"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <PasswordBox x:Name="NewPasswordBox"
                                         Height="48"
                                         Margin="0,10,0,8"
                                         Padding="14,0"
                                         VerticalContentAlignment="Center" />
                            <TextBlock Text="Tối thiểu 8 ký tự"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="2,0,0,14" />

                            <TextBlock Text="Nhập lại mật khẩu"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <PasswordBox x:Name="ConfirmPasswordBox"
                                         Height="48"
                                         Margin="0,10,0,16"
                                         Padding="14,0"
                                         VerticalContentAlignment="Center" />

                            <Button x:Name="ResetPasswordButton"
                                    Height="48"
                                    Background="{DynamicResource PrimaryBrush}"
                                    BorderBrush="{DynamicResource PrimaryBrush}"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Click="ResetPasswordButton_OnClick">
                                <TextBlock Text="Đặt lại mật khẩu" />
                            </Button>
                        </StackPanel>

                        <Border x:Name="StatusBorder"
                                Visibility="Collapsed"
                                Margin="0,18,0,0"
                                Padding="12"
                                Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource BorderBrushLight}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="StatusIcon"
                                           Text="&#xE946;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Foreground="{DynamicResource InfoBrush}"
                                           VerticalAlignment="Top"
                                           Margin="0,2,0,0" />
                                <TextBlock x:Name="StatusTextBlock"
                                           Grid.Column="1"
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           Foreground="{DynamicResource AccentSoftTextBrush}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
