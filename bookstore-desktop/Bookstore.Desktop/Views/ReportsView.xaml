<UserControl x:Class="Bookstore.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             SizeChanged="ReportsView_OnSizeChanged">
    <UserControl.Resources>
        <Style x:Key="ReportCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="ReportGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLineBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource GridLineBrush}" />
            <Setter Property="RowHeaderWidth" Value="0" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,4,8,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderFilterGrid" Grid.Row="0" Margin="0,0,0,18">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="HeaderTitleRow" Height="Auto" />
                    <RowDefinition x:Name="HeaderFiltersRow" Height="0" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="HeaderTitleColumn" Width="*" />
                    <ColumnDefinition x:Name="HeaderFromColumn" Width="Auto" />
                    <ColumnDefinition x:Name="HeaderToColumn" Width="Auto" />
                    <ColumnDefinition x:Name="HeaderLoadColumn" Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="HeaderTitlePanel">
                    <TextBlock Text="Báo cáo kinh doanh"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="Tổng hợp doanh thu, đơn hàng và tồn kho từ backend."
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>

                <StackPanel x:Name="FromDatePanel" Grid.Column="1" Margin="18,0,0,0">
                    <TextBlock Text="Từ ngày"
                               Margin="0,0,0,5"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <DatePicker Width="145"
                                SelectedDate="{Binding FromDate}"
                                Background="{DynamicResource TextBoxBackgroundBrush}"
                                Foreground="{DynamicResource TextBoxForegroundBrush}" />
                </StackPanel>

                <StackPanel x:Name="ToDatePanel" Grid.Column="2" Margin="12,0,0,0">
                    <TextBlock Text="Đến ngày"
                               Margin="0,0,0,5"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <DatePicker Width="145"
                                SelectedDate="{Binding ToDate}"
                                Background="{DynamicResource TextBoxBackgroundBrush}"
                                Foreground="{DynamicResource TextBoxForegroundBrush}" />
                </StackPanel>

                <Button x:Name="LoadReportButton"
                        Grid.Column="3"
                        Margin="12,22,0,0"
                        Content="Tải báo cáo"
                        Command="{Binding LoadCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>

            <Grid x:Name="SummaryGrid" Grid.Row="1" Margin="0,0,0,18">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="SummaryTopRow" Height="Auto" />
                    <RowDefinition x:Name="SummaryBottomRow" Height="0" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SummaryColumn0" Width="*" />
                    <ColumnDefinition x:Name="SummaryColumn1" Width="*" />
                    <ColumnDefinition x:Name="SummaryColumn2" Width="*" />
                    <ColumnDefinition x:Name="SummaryColumn3" Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="SummaryCard0" Grid.Column="0" Style="{StaticResource ReportCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Tổng doanh thu" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding Summary.TotalRevenueText}"
                                   Margin="0,8,0,0"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="{Binding Summary.TotalOrders, StringFormat={}{0:N0} đơn hàng}"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource InfoBrush}" />
                    </StackPanel>
                </Border>

                <Border x:Name="SummaryCard1" Grid.Column="1" Style="{StaticResource ReportCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Doanh thu hôm nay" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding Summary.TodayRevenueText}"
                                   Margin="0,8,0,0"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="{Binding Summary.TodayOrders, StringFormat={}{0:N0} đơn mới}"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource InfoBrush}" />
                    </StackPanel>
                </Border>

                <Border x:Name="SummaryCard2" Grid.Column="2" Style="{StaticResource ReportCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Doanh thu tháng" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding Summary.MonthRevenueText}"
                                   Margin="0,8,0,0"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="{Binding Summary.DeliveredOrders, StringFormat={}{0:N0} đơn đã giao}"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource InfoBrush}" />
                    </StackPanel>
                </Border>

                <Border x:Name="SummaryCard3" Grid.Column="3" Style="{StaticResource ReportCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Cần chú ý" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding Summary.LowStockBooks, StringFormat={}{0:N0} sách sắp hết}"
                                   Margin="0,8,0,0"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="{Binding Summary.PendingOrders, StringFormat={}{0:N0} đơn đang chờ}"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource InfoBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="RevenueStatusGrid" Grid.Row="2" Margin="0,0,0,18">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="RevenueStatusTopRow" Height="Auto" />
                    <RowDefinition x:Name="RevenueStatusBottomRow" Height="0" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="RevenueColumn" Width="1.4*" />
                    <ColumnDefinition x:Name="StatusColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="RevenueCard"
                        Grid.Column="0"
                        Style="{StaticResource ReportCardStyle}"
                        Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="260" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Doanh thu theo ngày"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,12" />
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Revenue}"
                                  Style="{StaticResource ReportGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ngày" Binding="{Binding Label}" Width="*" />
                                <DataGridTextColumn Header="Số đơn" Binding="{Binding Orders, StringFormat=N0}" Width="*" />
                                <DataGridTextColumn Header="Doanh thu" Binding="{Binding RevenueText}" Width="1.4*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border x:Name="StatusCard" Grid.Column="1" Style="{StaticResource ReportCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="260" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Trạng thái đơn hàng"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,12" />
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding OrderStatuses}"
                                  Style="{StaticResource ReportGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="1.6*" />
                                <DataGridTextColumn Header="Số lượng" Binding="{Binding Count, StringFormat=N0}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="CatalogGrid" Grid.Row="3" Margin="0,0,0,18">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="CatalogTopRow" Height="Auto" />
                    <RowDefinition x:Name="CatalogBottomRow" Height="0" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TopBooksColumn" Width="1.25*" />
                    <ColumnDefinition x:Name="LowStockColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="TopBooksCard"
                        Grid.Column="0"
                        Style="{StaticResource ReportCardStyle}"
                        Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="270" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Sách bán chạy"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,12" />
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding TopBooks}"
                                  Style="{StaticResource ReportGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tên sách" Binding="{Binding Title}" Width="2*" />
                                <DataGridTextColumn Header="Đã bán" Binding="{Binding SoldQuantity, StringFormat=N0}" Width="*" />
                                <DataGridTextColumn Header="Doanh thu" Binding="{Binding RevenueText}" Width="1.25*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border x:Name="LowStockCard" Grid.Column="1" Style="{StaticResource ReportCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="270" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Tồn kho thấp"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,12" />
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding LowStockBooks}"
                                  Style="{StaticResource ReportGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tên sách" Binding="{Binding Title}" Width="2*" />
                                <DataGridTextColumn Header="Tồn" Binding="{Binding StockQuantity, StringFormat=N0}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="4" Style="{StaticResource ReportCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="280" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Đơn hàng gần đây"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,12" />
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding RecentOrders}"
                              Style="{StaticResource ReportGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã đơn" Binding="{Binding CodeOrId}" Width="1.2*" />
                            <DataGridTextColumn Header="Khách hàng" Binding="{Binding CustomerName}" Width="1.5*" />
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="*" />
                            <DataGridTextColumn Header="Tổng tiền" Binding="{Binding FinalAmountText}" Width="1.2*" />
                            <DataGridTextColumn Header="Thời gian" Binding="{Binding CreatedAtText}" Width="1.25*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2"
                               Text="{Binding Message}"
                               Margin="0,12,0,0"
                               Foreground="{DynamicResource InfoBrush}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
