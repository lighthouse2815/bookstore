<UserControl x:Class="Bookstore.Desktop.Views.ReceiptPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Background="White" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="6" Padding="22" MaxWidth="560" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="{Binding Receipt.StoreName}" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Text="{Binding Receipt.OrderCode, StringFormat=Mã đơn: {0}}" Margin="0,14,0,0" />
                <TextBlock Text="{Binding Receipt.CreatedAtText, StringFormat=Ngày giờ: {0}}" />
                <TextBlock Text="{Binding Receipt.StaffName, StringFormat=Nhân viên: {0}}" />
                <TextBlock Text="{Binding Receipt.PaymentMethod, StringFormat=Thanh toán: {0}}" Margin="0,0,0,12" />

                <ItemsControl ItemsSource="{Binding Receipt.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,4">
                                <TextBlock Text="{Binding LineTotalText}" DockPanel.Dock="Right" FontWeight="SemiBold" />
                                <StackPanel>
                                    <TextBlock Text="{Binding BookTitle}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Quantity, StringFormat=SL: {0}}" Foreground="#4B5563" />
                                    <TextBlock Text="{Binding UnitPriceText, StringFormat=Đơn giá: {0}}" Foreground="#4B5563" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Separator Margin="0,12" />
                <DockPanel>
                    <TextBlock Text="Tạm tính" />
                    <TextBlock Text="{Binding Receipt.TotalText}" DockPanel.Dock="Right" />
                </DockPanel>
                <DockPanel>
                    <TextBlock Text="Giảm giá" />
                    <TextBlock Text="{Binding Receipt.DiscountText}" DockPanel.Dock="Right" />
                </DockPanel>
                <DockPanel Margin="0,8,0,0">
                    <TextBlock Text="Tổng cộng" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Receipt.FinalText}" DockPanel.Dock="Right" FontSize="18" FontWeight="SemiBold" />
                </DockPanel>

                <Button Content="In hóa đơn demo"
                        Height="38"
                        Margin="0,18,0,0"
                        Command="{Binding PrintDemoCommand}" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#2563EB" Margin="0,10,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
