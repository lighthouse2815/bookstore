<UserControl x:Class="Bookstore.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrushLight}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="22"
                MaxWidth="640"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Cài đặt"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Margin="0,0,0,18" />

                <Border Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrushLight}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,0,18">
                    <DockPanel LastChildFill="False">
                        <StackPanel Width="430">
                            <TextBlock Text="Giao diện"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="Bật chế độ tối cho khung ứng dụng và màn hình cài đặt."
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="12"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Right"
                                  Margin="18,0,0,0"
                                  VerticalAlignment="Center"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  IsChecked="{Binding IsDarkMode}"
                                  Content="Bật chế độ tối" />
                    </DockPanel>
                </Border>

                <TextBlock Text="Backend Base URL"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBox Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                         Height="36"
                         Padding="10,0"
                         Background="{DynamicResource TextBoxBackgroundBrush}"
                         Foreground="{DynamicResource TextBoxForegroundBrush}"
                         BorderBrush="{DynamicResource TextBoxBorderBrush}"
                         VerticalContentAlignment="Center"
                         Margin="0,6,0,14" />

                <TextBlock Text="Google OAuth Client ID"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBox Text="{Binding GoogleClientId, UpdateSourceTrigger=PropertyChanged}"
                         Height="36"
                         Padding="10,0"
                         Background="{DynamicResource TextBoxBackgroundBrush}"
                         Foreground="{DynamicResource TextBoxForegroundBrush}"
                         BorderBrush="{DynamicResource TextBoxBorderBrush}"
                         VerticalContentAlignment="Center"
                         Margin="0,6,0,6" />
                <TextBlock Text="Dùng OAuth Client ID cùng audience với backend GOOGLE_CLIENT_ID. Nếu token bị từ chối, kiểm tra lại cấu hình Google OAuth."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="12"
                           Margin="0,0,0,16" />

                <Button Content="Lưu"
                        Width="120"
                        Height="36"
                        Background="{DynamicResource PrimaryBrush}"
                        Foreground="White"
                        BorderBrush="{DynamicResource PrimaryBrush}"
                        HorizontalAlignment="Left"
                        Command="{Binding SaveCommand}" />
                <TextBlock Text="{Binding Message}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource InfoBrush}"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
