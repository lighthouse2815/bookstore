<UserControl x:Class="Bookstore.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="ThemeAwareButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <Image Source="/Bookstore.Desktop;component/Assets/login-background.png"
               Stretch="UniformToFill" />
        <Rectangle Fill="{DynamicResource AppBackgroundBrush}">
            <Rectangle.Style>
                <Style TargetType="Rectangle">
                    <Setter Property="Opacity" Value="0.2" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                            <Setter Property="Opacity" Value="0.84" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Rectangle.Style>
        </Rectangle>

        <Button Content="{Binding ThemeButtonText}"
                Command="{Binding ToggleThemeCommand}"
                Style="{StaticResource ThemeAwareButtonStyle}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,22,24,0"
                Padding="15,8"
                Background="{DynamicResource SurfaceBrush}"
                Foreground="{DynamicResource PrimaryTextBrush}"
                BorderBrush="{DynamicResource BorderBrushLight}"
                BorderThickness="1"
                FontWeight="SemiBold"
                Panel.ZIndex="2" />

        <Viewbox Stretch="Uniform"
                 StretchDirection="DownOnly"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="24">
            <Border Width="830"
                    Height="718"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrushLight}"
                    BorderThickness="1"
                    CornerRadius="18">
                <Border.Effect>
                    <DropShadowEffect Color="#8FA0B7"
                                      BlurRadius="26"
                                      ShadowDepth="8"
                                      Opacity="0.22" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="50" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="302" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrushLight}"
                                BorderThickness="0,0,1,0"
                                CornerRadius="18,0,0,0">
                            <Grid ClipToBounds="True">
                                <Image Source="/Bookstore.Desktop;component/Assets/login-illustration.png"
                                       Width="302"
                                       Height="466"
                                       Margin="0,24,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Stretch="UniformToFill" />
                                <Rectangle Fill="{DynamicResource SurfaceAltBrush}"
                                           IsHitTestVisible="False"
                                           Panel.ZIndex="1">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Opacity" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                                    <Setter Property="Opacity" Value="0.5" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <StackPanel Margin="56,514,34,0"
                                            VerticalAlignment="Top"
                                            Panel.ZIndex="2">
                                    <TextBlock Text="“"
                                               FontSize="54"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource InfoBrush}"
                                               Margin="0,0,0,-8" />
                                    <TextBlock Text="Tri thức là chìa khóa"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="mở cánh cửa tương lai."
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="0,4,0,18" />
                                    <TextBlock Text="- Khuyết danh -"
                                               FontSize="13"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1" Margin="50,58,52,34">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,34">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Bookstore.Desktop;component/Assets/logo-bookstore.png"
                                           Width="72"
                                           Height="72"
                                           Margin="-4,0,14,0"
                                           Stretch="Uniform" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Bookstore POS"
                                                   FontSize="38"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Text="Đăng nhập nhân viên"
                                                   FontSize="17"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="2,6,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Width="424">
                                <TextBlock Text="Email hoặc username"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBox Height="52"
                                         Margin="0,12,0,26"
                                         Padding="14,0"
                                         Background="{DynamicResource TextBoxBackgroundBrush}"
                                         Foreground="{DynamicResource TextBoxForegroundBrush}"
                                         BorderBrush="{DynamicResource TextBoxBorderBrush}"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Mật khẩu"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                <PasswordBox x:Name="PasswordInput"
                                             Height="52"
                                             Margin="0,12,0,10"
                                             Padding="14,0"
                                             Background="{DynamicResource TextBoxBackgroundBrush}"
                                             Foreground="{DynamicResource TextBoxForegroundBrush}"
                                             BorderBrush="{DynamicResource TextBoxBorderBrush}"
                                             VerticalContentAlignment="Center"
                                             PasswordChanged="PasswordInput_OnPasswordChanged" />

                                <Button Content="Quên mật khẩu?"
                                        Click="ForgotPasswordButton_OnClick"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,0,28"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource InfoBrush}"
                                        FontSize="13"
                                        Cursor="Hand" />

                                <Button Command="{Binding LoginCommand}"
                                        Height="52"
                                        Background="{DynamicResource PrimaryBrush}"
                                        BorderThickness="0"
                                        Foreground="White"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="LoginButtonChrome"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="LoginButtonChrome" Property="Opacity" Value="0.92" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="LoginButtonChrome" Property="Opacity" Value="0.82" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="LoginButtonChrome" Property="Opacity" Value="0.48" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE8FB;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Margin="0,0,10,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Đăng nhập"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Grid Margin="0,22,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Height="1"
                                            Background="{DynamicResource BorderBrushLight}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="hoặc"
                                               FontSize="13"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="18,0" />
                                    <Border Grid.Column="2"
                                            Height="1"
                                            Background="{DynamicResource BorderBrushLight}"
                                            VerticalAlignment="Center" />
                                </Grid>

                                <Button Command="{Binding GoogleLoginCommand}"
                                        Style="{StaticResource ThemeAwareButtonStyle}"
                                        Height="52"
                                        Background="{DynamicResource CardBrush}"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        BorderBrush="{DynamicResource BorderBrushLight}"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="G"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="#4285F4"
                                                   Margin="0,0,12,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Đăng nhập với Google"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <TextBlock Text="{Binding Message}"
                                           Margin="0,16,0,0"
                                           Foreground="#C2410C"
                                           FontSize="13"
                                           TextWrapping="Wrap" />

                                <TextBlock Text="Đang xử lý..."
                                           Foreground="{DynamicResource InfoBrush}"
                                           FontSize="13"
                                           Margin="0,8,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrushLight}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,18,18">
                        <DockPanel Margin="22,0">
                            <TextBlock Text="An toàn &amp; bảo mật"
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Phiên bản 1.0.0"
                                       DockPanel.Dock="Right"
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Viewbox>
    </Grid>
</UserControl>
