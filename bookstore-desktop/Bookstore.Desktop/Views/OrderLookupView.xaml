<UserControl x:Class="Bookstore.Desktop.Views.OrderLookupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ScreenBlueBrush" Color="#2D6BFF" />
        <SolidColorBrush x:Key="ScreenTextBrush" Color="#17356E" />
        <SolidColorBrush x:Key="ScreenBorderBrush" Color="#E6ECF7" />
        <SolidColorBrush x:Key="ScreenHeaderBrush" Color="#F4F7FD" />
        <SolidColorBrush x:Key="ScreenMutedBrush" Color="#7A8CAA" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource ScreenBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <Style x:Key="LargeSearchBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="52,0,14,0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource ScreenTextBrush}" />
            <Setter Property="BorderBrush" Value="#CBD7EE" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style x:Key="BlueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="{StaticResource ScreenBlueBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ScreenBlueBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WhiteButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D6DFEE" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Foreground" Value="#37465F" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F8FAFE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OrdersGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource ScreenBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF2FA" />
            <Setter Property="VerticalGridLinesBrush" Value="#EEF2FA" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource ScreenTextBrush}" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource ScreenHeaderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ScreenTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="BorderBrush" Value="#E9EEF8" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#2C3E63" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="56" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFE" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EEF4FF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,4,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Tra cứu đơn hàng"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#1E2B45" />
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="SearchBox"
                              Style="{StaticResource LargeSearchBoxStyle}"
                              Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="#A6B4CF"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               IsHitTestVisible="False" />
                    <TextBlock Text="Nhập order id hoặc order code"
                               Foreground="#A6B4CF"
                               FontSize="16"
                               Margin="54,0,0,0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Button Grid.Column="1"
                        Margin="16,0,0,0"
                        Style="{StaticResource BlueButtonStyle}"
                        Command="{Binding SearchCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Tìm kiếm"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Margin="18,0,0,0"
                        Style="{StaticResource WhiteButtonStyle}"
                        Command="{Binding RefreshRecentCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE823;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Đơn gần đây"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*" />
                <ColumnDefinition Width="1.55*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    Padding="16"
                    Margin="0,0,18,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="&#xE8A5;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   Foreground="{StaticResource ScreenBlueBrush}"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Danh sách đơn hàng"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#243753"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding RecentOrders}"
                              SelectedItem="{Binding SelectedOrder}"
                              Style="{StaticResource OrdersGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Mã đơn" Width="1.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A5;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="16"
                                                       Foreground="#5B7DBE"
                                                       Margin="0,0,12,0"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CodeOrId}"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Tổng" Binding="{Binding TotalText}" Width="0.9*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Grid.Row="2" Margin="4,16,4,0">
                        <TextBlock Text="{Binding RecentOrders.Count, StringFormat=Tổng cộng: {0} đơn hàng}"
                                   Foreground="#52657F"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="8" BorderBrush="#DDE6F4" BorderThickness="1" Background="#FAFBFE" Margin="0,0,8,0">
                                <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" Foreground="#9BAACC" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource ScreenBlueBrush}" Margin="0,0,8,0">
                                <TextBlock Text="1" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Width="36" Height="36" CornerRadius="8" BorderBrush="#DDE6F4" BorderThickness="1" Background="#FAFBFE">
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" Foreground="#9BAACC" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource CardStyle}"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource WhiteButtonStyle}"
                                Height="38"
                                Padding="14,0"
                                IsEnabled="{Binding CanReprint}"
                                Command="{Binding ReprintCommand}">
                            <TextBlock Text="Xuất lại .txt" />
                        </Button>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="20"
                                       Foreground="{StaticResource ScreenBlueBrush}"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Thông tin đơn hàng"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#243753"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1"
                            Style="{StaticResource CardStyle}"
                            Padding="20"
                            Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <TextBlock Text="Mã đơn:"
                                               Width="110"
                                               Foreground="#5E6F8E"
                                               FontSize="15" />
                                    <TextBlock Text="{Binding SelectedOrder.CodeOrId, TargetNullValue=--}"
                                               Foreground="{StaticResource ScreenBlueBrush}"
                                               FontSize="15"
                                               FontWeight="Bold" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <TextBlock Text="Trạng thái:"
                                               Width="110"
                                               Foreground="#5E6F8E"
                                               FontSize="15" />
                                    <TextBlock Text="{Binding SelectedOrder.Status, TargetNullValue=--}"
                                               FontSize="15"
                                               Foreground="#334968" />
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Tổng tiền:"
                                               Width="110"
                                               Foreground="#5E6F8E"
                                               FontSize="15" />
                                    <TextBlock Text="{Binding SelectedOrder.TotalText, TargetNullValue=--}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#334968" />
                                </DockPanel>
                            </StackPanel>

                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                 <Grid.RowDefinitions>
                                     <RowDefinition Height="Auto" />
                                     <RowDefinition Height="Auto" />
                                     <RowDefinition Height="Auto" />
                                     <RowDefinition Height="Auto" />
                                     <RowDefinition Height="Auto" />
                                 </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Ngày tạo:"
                                           Width="110"
                                           Foreground="#5E6F8E"
                                           FontSize="15" />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="{Binding SelectedOrder.CreatedAtText, TargetNullValue=--}"
                                           FontSize="15"
                                           Foreground="#334968" />

                                <TextBlock Grid.Row="1"
                                           Margin="0,14,0,0"
                                           Text="Phương thức:"
                                           Width="110"
                                           Foreground="#5E6F8E"
                                           FontSize="15" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Margin="0,14,0,0"
                                           Text="{Binding SelectedOrder.PaymentMethod, TargetNullValue=--}"
                                           FontSize="15"
                                           Foreground="#334968" />

                                <TextBlock Grid.Row="2"
                                           Margin="0,14,0,0"
                                           Text="Thanh toán:"
                                           Width="110"
                                           Foreground="#5E6F8E"
                                           FontSize="15" />
                                 <Border Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="0,14,0,0"
                                        Padding="10,4"
                                        CornerRadius="999"
                                        HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F1F3F7" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedOrder.PaymentStatusVariant}" Value="success">
                                                    <Setter Property="Background" Value="#E3F8EA" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedOrder.PaymentStatusVariant}" Value="warning">
                                                    <Setter Property="Background" Value="#FFF4DB" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedOrder.PaymentStatusVariant}" Value="danger">
                                                    <Setter Property="Background" Value="#FEE8E8" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding SelectedOrder.PaymentStatusText, TargetNullValue=Chua ro}"
                                               FontSize="14"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#6B7280" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedOrder.PaymentStatusVariant}" Value="success">
                                                        <Setter Property="Foreground" Value="#18A957" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedOrder.PaymentStatusVariant}" Value="warning">
                                                        <Setter Property="Foreground" Value="#D69B1B" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedOrder.PaymentStatusVariant}" Value="danger">
                                                        <Setter Property="Foreground" Value="#E14D4D" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                     </TextBlock>
                                 </Border>

                                 <TextBlock Grid.Row="3"
                                            Margin="0,14,0,0"
                                            Text="Khách hàng:"
                                            Width="110"
                                            Foreground="#5E6F8E"
                                            FontSize="15" />
                                 <TextBlock Grid.Row="3"
                                            Grid.Column="1"
                                            Margin="0,14,0,0"
                                            Text="{Binding SelectedOrder.CustomerName, TargetNullValue=--}"
                                            FontSize="15"
                                            Foreground="#334968" />

                                 <TextBlock Grid.Row="4"
                                            Margin="0,14,0,0"
                                            Text="Số điện thoại:"
                                            Width="110"
                                            Foreground="#5E6F8E"
                                            FontSize="15" />
                                 <TextBlock Grid.Row="4"
                                            Grid.Column="1"
                                            Margin="0,14,0,0"
                                            Text="{Binding SelectedOrder.CustomerPhone, TargetNullValue=--}"
                                            FontSize="15"
                                            Foreground="#334968" />
                             </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Style="{StaticResource CardStyle}"
                            Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Chi tiết sản phẩm"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#243753"
                                       Margin="20,16,20,12" />

                            <DataGrid Grid.Row="1"
                                      Margin="0,0,0,0"
                                      ItemsSource="{Binding SelectedOrder.Items}"
                                      Style="{StaticResource OrdersGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Sách" Width="1.7*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="34" Height="46" CornerRadius="6" Background="#EEF4FF" Margin="0,0,12,0">
                                                        <TextBlock Text="&#xE82D;"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="18"
                                                                   Foreground="#4B74D9"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="{Binding BookTitle}"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="Wrap"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="SL" Binding="{Binding Quantity}" Width="0.45*" />
                                    <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPriceText}" Width="0.85*" />
                                    <DataGridTextColumn Header="Thành tiền" Binding="{Binding LineTotalText}" Width="0.9*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <DockPanel Grid.Row="2" Margin="18,12,18,16">
                                <TextBlock Text="Tổng cộng:"
                                           DockPanel.Dock="Right"
                                           Foreground="#50627E"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0,0,14,0" />
                                <TextBlock Text="{Binding SelectedOrder.TotalText, TargetNullValue=--}"
                                           DockPanel.Dock="Right"
                                           Foreground="{StaticResource ScreenBlueBrush}"
                                           FontSize="18"
                                           FontWeight="Bold" />
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
            <TextBlock Text="&#xE946;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="16"
                       Foreground="#4777FF"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding Message}"
                       Foreground="#4777FF"
                       FontSize="14"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
