<UserControl x:Class="Bookstore.Desktop.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PosBlueBrush" Color="#2D6BFF" />
        <SolidColorBrush x:Key="PosBlueDarkBrush" Color="#163D8C" />
        <SolidColorBrush x:Key="PosBorderBrush" Color="#E6ECF7" />
        <SolidColorBrush x:Key="PosHeaderBrush" Color="#F4F7FD" />
        <SolidColorBrush x:Key="PosCardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PosTextBrush" Color="#17356E" />
        <SolidColorBrush x:Key="PosMutedBrush" Color="#6E7FA5" />
        <SolidColorBrush x:Key="PosGreenBrush" Color="#19B35A" />
        <SolidColorBrush x:Key="PosGreenDarkBrush" Color="#119747" />
        <SolidColorBrush x:Key="PosDeleteBrush" Color="#FF6B6B" />

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PosCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PosBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PosTextBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource PosTextBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD7EE" />
            <Setter Property="BorderThickness" Value="1.2" />
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource PosTextBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D9E3F2" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="50" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource PosTextBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D9E3F2" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="BlueActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource PosBlueBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PosBlueBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="#F9FBFF" />
            <Setter Property="BorderBrush" Value="#7AA2FF" />
            <Setter Property="BorderThickness" Value="1.4" />
            <Setter Property="Foreground" Value="{StaticResource PosBlueBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#EEF4FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.84" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#F5F7FB" />
            <Setter Property="BorderBrush" Value="#DCE5F4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#5F6D86" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#EEF3FD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeleteMiniButtonStyle" TargetType="Button" BasedOn="{StaticResource MiniButtonStyle}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="#FFF7F7" />
            <Setter Property="BorderBrush" Value="#FFB7B7" />
            <Setter Property="Foreground" Value="{StaticResource PosDeleteBrush}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style x:Key="CheckoutButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="54" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource PosGreenBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PosGreenBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PosGreenDarkBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="54" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D6DFEE" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Foreground" Value="#1F2B44" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F8FAFE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchResultsGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource PosTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PosBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF2FA" />
            <Setter Property="VerticalGridLinesBrush" Value="#EEF2FA" />
            <Setter Property="SelectionMode" Value="Single" />
        </Style>

        <Style x:Key="CartGridStyle" TargetType="DataGrid" BasedOn="{StaticResource SearchResultsGridStyle}">
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF1F6" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource PosHeaderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PosTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="BorderBrush" Value="#E9EEF8" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource PosTextBrush}" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="62" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource PosTextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FBFCFF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EEF4FF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,4,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="POS bán hàng"
                       Style="{StaticResource SectionTitleTextStyle}"
                       FontSize="26" />
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="104" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Style="{StaticResource SearchTextBoxStyle}"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1"
                        Margin="14,0,0,0"
                        Style="{StaticResource BlueActionButtonStyle}"
                        Command="{Binding SearchCommand}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Tìm"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.95*" />
                <ColumnDefinition Width="1.55*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="12"
                    Margin="0,0,18,0">
                <Grid>
                    <DataGrid ItemsSource="{Binding SearchResults}"
                              Style="{StaticResource SearchResultsGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên sách" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}" Width="0.95*" />
                            <DataGridTextColumn Header="Giá" Binding="{Binding PriceText}" Width="1.15*" />
                            <DataGridTextColumn Header="Tồn" Binding="{Binding StockText}" Width="0.9*" />
                            <DataGridTemplateColumn Header="Thao tác" Width="1.15*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource AddButtonStyle}"
                                                Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="+"
                                                           FontSize="20"
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="Thêm"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE719;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="28"
                                   Foreground="#0F172A"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Giỏ hàng"
                                   Style="{StaticResource SectionTitleTextStyle}"
                                   FontSize="24"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Style="{StaticResource CardBorderStyle}"
                            Padding="0"
                            Margin="0,18,0,18">
                        <DataGrid ItemsSource="{Binding CartItems}"
                                  Style="{StaticResource CartGridStyle}"
                                  HeadersVisibility="Column"
                                  MinHeight="128">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Sách" Binding="{Binding Title}" Width="1.6*" />
                                <DataGridTextColumn Header="SL" Binding="{Binding Quantity}" Width="0.8*" />
                                <DataGridTextColumn Header="Tiền" Binding="{Binding LineTotalText}" Width="1.1*" />
                                <DataGridTemplateColumn Header="Thao tác" Width="1.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="-"
                                                        Style="{StaticResource MiniButtonStyle}"
                                                        Command="{Binding DataContext.DecreaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="+"
                                                        Style="{StaticResource MiniButtonStyle}"
                                                        Command="{Binding DataContext.IncreaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="&#xE74D;"
                                                        Style="{StaticResource DeleteMiniButtonStyle}"
                                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="2">
                        <Border Height="1"
                                Background="#E8EDF6"
                                Margin="0,0,0,20" />

                        <DockPanel Margin="0,0,0,18">
                            <TextBlock Text="Số lượng"
                                       Foreground="#1E2C47"
                                       FontSize="15" />
                            <TextBlock Text="{Binding TotalQuantityText}"
                                       DockPanel.Dock="Right"
                                       Foreground="#1E2C47"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                        </DockPanel>

                        <DockPanel Margin="0,0,0,22">
                            <TextBlock Text="Tổng tiền"
                                       Foreground="{StaticResource PosTextBrush}"
                                       FontSize="18"
                                       FontWeight="Bold" />
                            <TextBlock Text="{Binding TotalAmountText}"
                                       DockPanel.Dock="Right"
                                       Foreground="{StaticResource PosBlueBrush}"
                                       FontSize="20"
                                       FontWeight="Bold" />
                        </DockPanel>

                        <TextBlock Text="Mã giảm giá"
                                   Foreground="#23375F"
                                   FontSize="15"
                                   Margin="0,0,0,8" />
                        <TextBox Style="{StaticResource InputTextBoxStyle}"
                                 Margin="0,0,0,20"
                                 Text="{Binding CouponCode, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Phương thức thanh toán"
                                   Foreground="#23375F"
                                   FontSize="15"
                                   Margin="0,0,0,8" />
                        <ComboBox Style="{StaticResource InputComboBoxStyle}"
                                  Margin="0,0,0,18"
                                  ItemsSource="{Binding PaymentMethods}"
                                  SelectedItem="{Binding SelectedPaymentMethod}" />

                        <Button Style="{StaticResource CheckoutButtonStyle}"
                                Margin="0,0,0,14"
                                Command="{Binding CheckoutCommand}"
                                IsEnabled="{Binding CanCheckout}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE14C;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Tạo đơn / Thanh toán"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SecondaryActionButtonStyle}"
                                Command="{Binding ClearCartCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE74D;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Xóa giỏ"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,16,0,0">
            <TextBlock Text="&#xE946;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="16"
                       Foreground="#4777FF"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding Message}"
                       Foreground="#4777FF"
                       FontSize="14"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
