<UserControl x:Class="Bookstore.Desktop.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PosGreenBrush" Color="#19B35A" />
        <SolidColorBrush x:Key="PosGreenDarkBrush" Color="#119747" />

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource TextBoxForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.2" />
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource TextBoxForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="50" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource TextBoxForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource TextBoxBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <ContentPresenter x:Name="SelectedContent"
                                                      Margin="14,0,42,0"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                                    <TextBox x:Name="PART_EditableTextBox"
                                             Margin="14,0,42,0"
                                             Padding="0"
                                             Visibility="Collapsed"
                                             Focusable="True"
                                             IsReadOnly="{TemplateBinding IsReadOnly}"
                                             VerticalContentAlignment="Center"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{TemplateBinding Foreground}"
                                             FontSize="{TemplateBinding FontSize}" />
                                    <TextBlock Text="&#xE70D;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,0,16,0" />
                                </Grid>
                            </Border>

                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,4,0,0"
                                        Padding="4"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrushLight}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <ScrollViewer MaxHeight="260"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="SelectedContent" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                                <Setter TargetName="DropDownToggle" Property="Width" Value="42" />
                                <Setter TargetName="DropDownToggle" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.52" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BlueActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1.4" />
            <Setter Property="Foreground" Value="{DynamicResource AccentSoftTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SelectionBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.84" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeleteMiniButtonStyle" TargetType="Button" BasedOn="{StaticResource MiniButtonStyle}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style x:Key="CheckoutButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="54" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource PosGreenBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PosGreenBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PosGreenDarkBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="54" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchResultsGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLineBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource GridLineBrush}" />
            <Setter Property="SelectionMode" Value="Single" />
        </Style>

        <Style x:Key="CartGridStyle" TargetType="DataGrid" BasedOn="{StaticResource SearchResultsGridStyle}">
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLineBrush}" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="62" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="PageRoot"
          Margin="0,4,0,0"
          SizeChanged="PosView_OnSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="POS bán hàng"
                       Style="{StaticResource SectionTitleTextStyle}"
                       FontSize="26" />
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="104" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Style="{StaticResource SearchTextBoxStyle}"
                         ToolTip="Tìm theo tên sách"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="1"
                        Margin="14,0,0,0"
                        Style="{StaticResource BlueActionButtonStyle}"
                        IsEnabled="{Binding CanEditCart}"
                        Command="{Binding SearchCommand}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Tìm"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <ScrollViewer x:Name="WorkspaceScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch">
            <Grid x:Name="WorkspaceGrid">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ResultsRow" Height="*" />
                    <RowDefinition x:Name="CartRow" Height="0" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ResultsColumn" Width="1.95*" />
                    <ColumnDefinition x:Name="CartColumn" Width="1.55*" />
                </Grid.ColumnDefinitions>

            <Border x:Name="ResultsCard"
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="12"
                    Margin="0,0,18,0">
                <Grid>
                    <DataGrid ItemsSource="{Binding SearchResults}"
                              Style="{StaticResource SearchResultsGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên sách" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}" Width="0.95*" />
                            <DataGridTextColumn Header="Giá" Binding="{Binding PriceText}" Width="1.15*" />
                            <DataGridTextColumn Header="Tồn" Binding="{Binding StockText}" Width="0.9*" />
                            <DataGridTemplateColumn Header="Thao tác" Width="1.15*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource AddButtonStyle}"
                                                IsEnabled="{Binding DataContext.CanEditCart, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="+"
                                                           FontSize="20"
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="Thêm"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border x:Name="CartCard"
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE719;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="28"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Giỏ hàng"
                                   Style="{StaticResource SectionTitleTextStyle}"
                                   FontSize="24"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Style="{StaticResource CardBorderStyle}"
                            Padding="0"
                            Margin="0,18,0,18">
                        <DataGrid ItemsSource="{Binding CartItems}"
                                  Style="{StaticResource CartGridStyle}"
                                  HeadersVisibility="Column"
                                  MinHeight="148"
                                  MaxHeight="260">
                            <DataGrid.Columns>
                                 <DataGridTextColumn Header="Sách" Binding="{Binding Title}" Width="1.6*" />
                                 <DataGridTextColumn Header="SL" Binding="{Binding Quantity}" Width="0.8*" />
                                 <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPriceText}" Width="1*" />
                                 <DataGridTextColumn Header="Tồn" Binding="{Binding StockText}" Width="0.65*" />
                                 <DataGridTextColumn Header="Tiền" Binding="{Binding LineTotalText}" Width="1.1*" />
                                <DataGridTemplateColumn Header="Thao tác" Width="1.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                 <Button Content="-"
                                                         Style="{StaticResource MiniButtonStyle}"
                                                         IsEnabled="{Binding DataContext.CanEditCart, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         Command="{Binding DataContext.DecreaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                 <Button Content="+"
                                                         Style="{StaticResource MiniButtonStyle}"
                                                         IsEnabled="{Binding DataContext.CanEditCart, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         Command="{Binding DataContext.IncreaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                 <Button Content="&#xE74D;"
                                                         Style="{StaticResource DeleteMiniButtonStyle}"
                                                         IsEnabled="{Binding DataContext.CanEditCart, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <ScrollViewer x:Name="CartFormScrollViewer"
                                  Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,6,0">
                        <Border Height="1"
                                Background="{DynamicResource BorderBrushLight}"
                                Margin="0,0,0,20" />

                        <DockPanel Margin="0,0,0,18">
                            <TextBlock Text="Số lượng"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="15" />
                            <TextBlock Text="{Binding TotalQuantityText}"
                                       DockPanel.Dock="Right"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                        </DockPanel>

                        <DockPanel Margin="0,0,0,22">
                            <TextBlock Text="Tổng tiền"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="18"
                                       FontWeight="Bold" />
                            <TextBlock Text="{Binding TotalAmountText}"
                                       DockPanel.Dock="Right"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       FontSize="20"
                                       FontWeight="Bold" />
                        </DockPanel>

                        <TextBlock Text="Mã giảm giá"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="15"
                                   Margin="0,0,0,8" />
                        <ComboBox Style="{StaticResource InputComboBoxStyle}"
                                  Margin="0,0,0,6"
                                  ItemsSource="{Binding AvailableCoupons}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  StaysOpenOnEdit="True"
                                  TextSearch.TextPath="Code"
                                  Text="{Binding CouponCode, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Code}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DetailText}"
                                                   Margin="0,3,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding CouponHelpText}"
                                   Margin="2,0,0,20"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap" />

                        <CheckBox Content="Khách lẻ (không nhập thông tin)"
                                  IsChecked="{Binding UseWalkInCustomer}"
                                  Foreground="{DynamicResource SecondaryTextBrush}"
                                  FontSize="15"
                                  Margin="0,0,0,12" />
                        <StackPanel IsEnabled="{Binding IsCustomerDetailsEnabled}">
                            <TextBlock Text="Tên khách (không bắt buộc)"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="15"
                                       Margin="0,0,0,8" />
                            <TextBox Style="{StaticResource InputTextBoxStyle}"
                                     Margin="0,0,0,12"
                                     Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Số điện thoại (không bắt buộc)"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="15"
                                       Margin="0,0,0,8" />
                            <TextBox Style="{StaticResource InputTextBoxStyle}"
                                     Margin="0,0,0,20"
                                     Text="{Binding CustomerPhone, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <TextBlock Text="Phương thức thanh toán"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="15"
                                   Margin="0,0,0,8" />
                        <ComboBox Style="{StaticResource InputComboBoxStyle}"
                                   Margin="0,0,0,18"
                                   ItemsSource="{Binding PaymentMethods}"
                                   DisplayMemberPath="DisplayName"
                                   SelectedItem="{Binding SelectedPaymentMethod}" />

                        <StackPanel Margin="0,0,0,18">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCashPayment}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Tiền khách đưa (tùy chọn)"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="15"
                                       Margin="0,0,0,8" />
                            <TextBox Style="{StaticResource InputTextBoxStyle}"
                                     Margin="0,0,0,8"
                                     ToolTip="Để trống nếu không cần tính tiền thừa"
                                     TextChanged="CashReceivedTextBox_OnTextChanged"
                                     Text="{Binding CashReceivedText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding CashReceivedInWordsText}"
                                       Margin="2,0,0,8"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="12"
                                       FontStyle="Italic"
                                       TextWrapping="Wrap" />
                            <DockPanel>
                                <TextBlock Text="Tiền thừa"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding CashChangeText}"
                                           DockPanel.Dock="Right"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           FontWeight="SemiBold" />
                            </DockPanel>
                        </StackPanel>

                        <Button Style="{StaticResource CheckoutButtonStyle}"
                                Margin="0,0,0,14"
                                Command="{Binding CheckoutCommand}"
                                IsEnabled="{Binding CanCheckout}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE14C;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CheckoutButtonText}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SecondaryActionButtonStyle}"
                                IsEnabled="{Binding CanEditCart}"
                                Command="{Binding ClearCartCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE74D;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Xóa giỏ"
                                           VerticalAlignment="Center" />
                                </StackPanel>
                        </Button>

                        <StackPanel Margin="0,14,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLastReceipt}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding LastOrderSummary}"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8" />
                            <Button Style="{StaticResource SecondaryActionButtonStyle}"
                                    Height="44"
                                    Margin="0,0,0,8"
                                    Command="{Binding OpenLastReceiptCommand}">
                                <TextBlock Text="Mở hóa đơn / Xuất .txt" />
                            </Button>
                            <Button Style="{StaticResource SecondaryActionButtonStyle}"
                                    Height="44"
                                    Command="{Binding OpenLastOrderDetailCommand}">
                                <TextBlock Text="Mở chi tiết đơn vừa tạo" />
                            </Button>
                        </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,16,0,0">
            <TextBlock Text="&#xE946;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="16"
                       Foreground="{DynamicResource InfoBrush}"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding Message}"
                       Foreground="{DynamicResource InfoBrush}"
                       FontSize="14"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
