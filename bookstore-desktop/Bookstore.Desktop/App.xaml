<Application x:Class="Bookstore.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F6F8FB" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#1F2937" />
        <SolidColorBrush x:Key="SidebarForegroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SidebarDividerBrush" Color="#4B5563" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="BorderBrushLight" Color="#DDE3EA" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111827" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#64748B" />
        <SolidColorBrush x:Key="TextBoxBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextBoxForegroundBrush" Color="#111827" />
        <SolidColorBrush x:Key="TextBoxBorderBrush" Color="#CBD5E1" />
        <SolidColorBrush x:Key="InfoBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="GridLineBrush" Color="#E5EAF2" />
        <SolidColorBrush x:Key="HoverBrush" Color="#F3F6FC" />
        <SolidColorBrush x:Key="SelectionBrush" Color="#E4EDFF" />
        <SolidColorBrush x:Key="SelectionTextBrush" Color="#17356E" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#EEF4FF" />
        <SolidColorBrush x:Key="AccentSoftTextBrush" Color="#3568D4" />
        <SolidColorBrush x:Key="NeutralStatusBrush" Color="#64748B" />
        <SolidColorBrush x:Key="NeutralStatusSurfaceBrush" Color="#F1F3F7" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
        <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#E9F8EF" />
        <SolidColorBrush x:Key="WarningBrush" Color="#A16207" />
        <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FFF5D6" />
        <SolidColorBrush x:Key="DangerBrush" Color="#C24141" />
        <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FDECEC" />
    </Application.Resources>
</Application>
