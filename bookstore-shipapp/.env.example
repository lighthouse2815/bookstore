# Copy this file to .env and set one real backend URL. Do not commit .env.
# Android Emulator: http://10.0.2.2:<port>/api (replace <port>, for example 8080)
# Real phone: http://<LAN_IP>:<port>/api (use the backend machine LAN IP)
# Do not use localhost or 127.0.0.1 on a mobile device.
EXPO_PUBLIC_API_BASE_URL=
