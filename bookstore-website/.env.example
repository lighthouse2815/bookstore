# Frontend API base URL
VITE_API_BASE_URL=http://localhost:8080/api

# Google Sign-In client id for the website
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Bank transfer demo placeholders for local checkout screens
# Do not commit real production banking information into this repo.
VITE_BANK_TRANSFER_BANK_NAME=MB Bank
VITE_BANK_TRANSFER_BANK_CODE=MB
VITE_BANK_TRANSFER_ACCOUNT_NUMBER=your-demo-account-number
VITE_BANK_TRANSFER_ACCOUNT_NAME=YOUR DEMO ACCOUNT NAME
VITE_BANK_TRANSFER_QR_URL=https://img.vietqr.io/image/vcb-0123456789-compact2.jpg?accountName=SACHVUI%20BOOKSTORE

# Optional public social profiles. Links are hidden when left blank.
VITE_FACEBOOK_URL=
VITE_INSTAGRAM_URL=
