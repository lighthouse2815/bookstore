# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bookstore_db
DB_USER=bookstore_user
DB_PASSWORD=your_database_password

# Server
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:3000,http://127.0.0.1:3000

# API docs / Swagger
# Demo/dev: true
# Real production: false
APP_SWAGGER_ENABLED=true

# Docker MySQL
MYSQL_CONTAINER_NAME=bookstore-mysql
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# Development seed profile
# Supported ranges: APP_SEED_SIZE=15..50, APP_SEED_CATEGORY_COUNT=6..16
APP_DEMO_SEED_ENABLED=false
APP_SEED_SIZE=50
APP_SEED_CATEGORY_COUNT=12
# Shared password for demo-only customer/staff/shipper accounts when demo seed is enabled
APP_DEMO_USER_PASSWORD=change_me_demo_seed_password

# Admin seed
# Set APP_ADMIN_SEED_ENABLED=true when you want the backend to create the first admin account.
APP_ADMIN_SEED_ENABLED=false
ADMIN_USERNAME=admin_demo
ADMIN_PASSWORD=change_me_admin_password
ADMIN_PHONE=0900000001
ADMIN_EMAIL=admin_demo@example.com
ADMIN_LAST_NAME=Demo
ADMIN_FIRST_NAME=Admin

# JWT
JWT_SECRET=replace_with_a_32_char_minimum_secret
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=30

# Authentication/session hardening
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_MAX_REQUESTS_PER_EMAIL=5
PASSWORD_RESET_MAX_REQUESTS_PER_IP=20
PASSWORD_RESET_WINDOW_MINUTES=15
PASSWORD_RESET_LOCK_MINUTES=15
# false locally; production HTTPS must use true.
AUTH_WEB_COOKIE_SECURE=false
AUTH_WEB_COOKIE_SAME_SITE=Lax
AUTH_WEB_COOKIE_MAX_AGE_SECONDS=2592000
# Enable only behind a proxy you control; never trust X-Forwarded-For directly.
AUTH_TRUSTED_PROXY_ENABLED=false
AUTH_TRUSTED_PROXY_CIDRS=

# Google Sign-In
GOOGLE_CLIENT_ID=your_google_web_client_id

# OTP Email Verification
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RESEND_MAX_REQUESTS=5
OTP_RESEND_MAX_REQUESTS_PER_WINDOW=5
OTP_RESEND_WINDOW_MINUTES=15

# Resend Email API
# RESEND_API_KEY: API key from Resend
# RESEND_FROM_EMAIL: verified sender email/domain on Resend
RESEND_BASE_URL=https://api.resend.com
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=your_verified_sender@example.com
RESEND_FROM_NAME=Bookstore

# SePay
# At least one of SEPAY_SECRET_KEY or SEPAY_WEBHOOK_API_KEY must be configured,
# otherwise /api/payments/sepay/ipn will reject all requests.
SEPAY_MERCHANT_ID=your_sepay_merchant_id
SEPAY_SECRET_KEY=your_sepay_secret_key
SEPAY_WEBHOOK_API_KEY=your_sepay_webhook_api_key

# Payment expiry / reconciliation scheduler
# Bank transfer expiry must be between 5 and 1440 minutes.
BANK_TRANSFER_EXPIRATION_MINUTES=20
PAYMENT_EXPIRY_JOB_ENABLED=true
PAYMENT_EXPIRY_JOB_DELAY_MS=60000
PAYMENT_EXPIRY_JOB_BATCH_SIZE=100

# Transactional outbox. Keep enabled in staging/production; the worker retries notifications after commit.
OUTBOX_ENABLED=true
OUTBOX_DELAY_MS=5000
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_PROCESSING_TIMEOUT_SECONDS=300
OUTBOX_BACKLOG_WARNING_THRESHOLD=1000

# Object storage / presigned URL
STORAGE_PROVIDER=r2
STORAGE_BUCKET=your-storage-bucket
STORAGE_REGION=auto
STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key
STORAGE_PUBLIC_BASE_URL=https://cdn.example.com
STORAGE_PRESIGN_UPLOAD_EXPIRE_MINUTES=10
STORAGE_PRESIGN_DOWNLOAD_EXPIRE_MINUTES=5
STORAGE_MAX_IMAGE_SIZE_MB=5
STORAGE_MAX_DIGITAL_FILE_SIZE_MB=200
